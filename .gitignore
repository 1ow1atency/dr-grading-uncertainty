# Data (download separately, see data/README or main README)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Model artifacts
*.pt
*.pth
*.ckpt
*.h5

# Exception: the deployed Streamlit demo (app.py) needs this checkpoint at
# runtime, so it's committed despite the blanket *.pt ignore above.
!results/checkpoints/best_model.pt

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/
*.egg-info/

# OS
.DS_Store
